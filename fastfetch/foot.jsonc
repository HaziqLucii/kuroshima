{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // Minimalist, no image logo: foot only supports Sixel, not the kitty
    // graphics protocol config.jsonc's dithered PNG relies on, which is
    // what broke rendering here. Flat key-value rows instead of that
    // rounded-corner ASCII box, matching the hairline-row dossier style
    // used elsewhere (kuroshima's theme/Theme.qml, fuzzel/fuzzel.ini):
    // dim grey labels, bone-ink values (foot's own default foreground),
    // no accent colour.
    "logo": {
        "type": "none"
    },
    "display": {
        "separator": "  "
    },
    "modules": [
        {
            "type": "custom",
            "format": "\u001b[38;2;92;92;92m────────────────────────────\u001b[0m"
        },
        {
            "type": "title",
            "format": "\u001b[1m\u001b[38;2;237;237;237m{user-name}\u001b[0m\u001b[38;2;92;92;92m@\u001b[0m\u001b[1m\u001b[38;2;237;237;237m{host-name}\u001b[0m"
        },
        "break",
        {
            "type": "os",
            "key": "\u001b[38;2;92;92;92mOS\u001b[0m",
            "format": "{3}"
        },
        {
            "type": "kernel",
            "key": "\u001b[38;2;92;92;92mKERNEL\u001b[0m",
            "format": "{release}"
        },
        {
            "type": "wm",
            "key": "\u001b[38;2;92;92;92mWM\u001b[0m",
            "format": "{2}"
        },
        {
            "type": "shell",
            "key": "\u001b[38;2;92;92;92mSHELL\u001b[0m",
            "format": "{pretty-name}"
        },
        {
            "type": "terminal",
            "key": "\u001b[38;2;92;92;92mTERM\u001b[0m"
        },
        {
            "type": "packages",
            "key": "\u001b[38;2;92;92;92mPKGS\u001b[0m",
            "format": "{all}"
        },
        {
            "type": "memory",
            "key": "\u001b[38;2;92;92;92mMEM\u001b[0m"
        },
        {
            "type": "uptime",
            "key": "\u001b[38;2;92;92;92mUP\u001b[0m"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;92;92;92m────────────────────────────\u001b[0m"
        }
    ]
}
