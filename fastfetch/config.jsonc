{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "source": "~/.config/fastfetch/kuroshima-logo-dither.png",
        "padding": {
            "left": 2,
            "right": 2
        },
        "width": 25
    },
    "display": {
        "separator": "  ",
        "color": "white",
        "constants": ["\u001b[37m", "\u001b[37m", "\u001b[37m", "\u001b[37m", "\u001b[39m"]
    },
    "modules": [
        {
            "type": "custom",
            "key": "{$1}╭───────────────────────────────────╮"
        },
        {
            "type": "kernel",
            "key": "{$1}│ {$2}{$1}  kernel",
            "format": "{$5}{release>22}{$1} │"
        },
        {
            "type": "command",
            "key": "{$1}│   uptime",
            "text": "uptime -p | cut -d ' ' -f 2-",
            "format": "{$5}{>22}{$1} │"
        },
        {
            "type": "shell",
            "key": "{$1}│ {$2}{$1}  shell ",
            "format": "{$5}{pretty-name>22}{$1} │"
        },
        {
            "type": "command",
            "key": "{$1}│ {$3}{$1}  mem   ",
            "text": "free -m | awk 'NR==2{printf \"%.2f GiB / %.2f GiB\",$3/1024,$2/1024}'",
            "format": "{$5}{>22}{$1} │"
        },
        {
            "type": "packages",
            "key": "{$1}│   pkgs  ",
            "format": "{$5}{all>22}{$1} │"
        },
        {
            "type": "command",
            "key": "{$1}│ {$2}{$1}  user  ",
            "text": "echo $USER",
            "format": "{$5}{>22}{$1} │"
        },
        {
            "type": "command",
            "key": "{$1}│   hname ",
            "text": "hostnamectl hostname",
            "format": "{$5}{>22}{$1} │"
        },
        {
            "type": "os",
            "key": "{$1}│ {$4}{$1}󰻀  distro",
            "format": "{$5}{pretty-name>22}{$1} │"
        },
        {
            "type": "custom",
            "key": "{$1}╰───────────────────────────────────╯"
        },
        "break"
    ]
}
